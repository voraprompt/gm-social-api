from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import requests

app = FastAPI()

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

class VideoRequest(BaseModel):
    url: str

RAPIDAPI_KEY = "fe64982d69msh9912a3389f014cfp15b50bjsn7c1175c1ff2d"
RAPIDAPI_HOST = "auto-download-all-in-one-big.p.rapidapi.com"

def find_video_link(data):
    """RapidAPI ke response se deep search karke MP4 link dhoondta hai"""
    if isinstance(data, str) and data.startswith("http"):
        # Agar link direct video file ya CDN hai
        if any(ext in data.lower() for ext in [".mp4", "googlevideo", "tiktokcdn", "fbcdn", "cdninstagram"]):
            return data
    elif isinstance(data, dict):
        # Pehle common download keys check karein
        for key in ["download_url", "video", "play", "no_watermark", "url", "link"]:
            if key in data:
                res = find_video_link(data[key])
                if res: return res
        # Agar na mile to poore dict mein recursive search karein
        for value in data.values():
            res = find_video_link(value)
            if res: return res
    elif isinstance(data, list):
        for item in data:
            res = find_video_link(item)
            if res: return res
    return None

@app.get("/")
def read_root():
    return {"message": "API Active"}

@app.post("/extract")
def extract_video(req: VideoRequest):
    raw_url = req.url.strip()
    if not raw_url:
        raise HTTPException(status_code=400, detail="URL is empty")

    # 1. TIKTOK DIRECT ENGINE (Fastest)
    if "tiktok.com" in raw_url:
        try:
            r = requests.post("https://www.tikwm.com/api/", data={"url": raw_url}, timeout=8).json()
            if r.get("code") == 0 and "play" in r.get("data", {}):
                link = r["data"]["play"]
                if not link.startswith("http"):
                    link = "https://www.tikwm.com" + link
                return {"status": "success", "download_url": link}
        except Exception:
            pass

    # 2. RAPIDAPI ENGINE (All Social Media)
    try:
        headers = {
            "x-rapidapi-key": RAPIDAPI_KEY,
            "x-rapidapi-host": RAPIDAPI_HOST,
            "Content-Type": "application/json"
        }
        endpoint = f"https://{RAPIDAPI_HOST}/v1/social/autolink"
        resp = requests.post(endpoint, json={"url": raw_url}, headers=headers, timeout=12)
        
        if resp.status_code == 200:
            json_data = resp.json()
            video_url = find_video_link(json_data)
            if video_url:
                return {"status": "success", "download_url": video_url}
    except Exception:
        pass

    raise HTTPException(status_code=400, detail="Extraction failed for this URL")
